@@ -107,21 +107,21 @@ class PriceAskingProductReader
      * @param string[] $tempOpenIn mã YCHG khác đang mở (kể cả Nháp) có chứa hàng — chỉ xét cho hàng tạm
      */
     public static function blockReason(?int $status, array $askingIn, array $tempOpenIn = []): ?string
     {
         if (in_array($status, self::SELECTABLE_STATUSES, true)) {
             return null;
         }
         if (in_array($status, self::TEMP_SELECTABLE_STATUSES, true)) {
             return $tempOpenIn ? 'Hàng tạm đang nằm trong yêu cầu hỏi giá ' . implode(', ', $tempOpenIn) : null;
         }
-        if ($status === ProductCompany::STATUS_TEMP_APPROVED) {
+        if ($status === ProductCompany::STATUS_TEMP_APPROVED || $status === ProductCompany::STATUS_TEMP_APPROVED_NO_PRICE) {
             return 'Hàng tạm đã được duyệt, đang chờ duyệt phiếu yêu cầu hỏi giá';
         }
         if (in_array($status, ProductCompany::PRICING_FLOW_STATUSES, true)) {
             return 'Hàng đang được hỏi giá' . ($askingIn ? ' ở ' . implode(', ', $askingIn) : '');
         }
         if ($status === ProductCompany::STATUS_STOPPED) {
             return 'Hàng ngừng kinh doanh tại công ty';
         }
 
         return 'Hàng chưa dùng ở công ty';
