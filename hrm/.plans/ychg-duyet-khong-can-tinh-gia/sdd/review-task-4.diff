+     */
+    private function resolveNoPriceLines(array $productIds, int $companyId): array
+    {
+        $resolver = app(TempNoPriceResolver::class);
+        $out = [];
+        $invalid = [];
+        foreach ($productIds as $pid) {
+            $r = $resolver->resolve($pid, $companyId);
+            if ($r === null) {
+                $invalid[] = $pid;
+            } else {
+                $out[$pid] = $r;
+            }
+        }
+        if ($invalid) {
+            $codes = DB::table('products')->whereIn('id', $invalid)->orderBy('id')->pluck('code')->implode(', ');
+            throw ValidationException::withMessages(['temp_products' => [$codes . ': chưa đủ điều kiện duyệt không cần tính giá']]);
+        }
+
+        return $out;
+    }
+
+    /**
+     * Dòng 9: ghi bộ giá danh mục (cả 6 loại giá bán = giá bán resolver, TMĐT đặt tay để không tự nhân hệ số) + giá vốn,
+     * rồi 9 → 3 Đang KD (khuôn PriceCalculateFinalizer::promoteProducts, không qua Chờ tính giá). Gọi TRONG transaction.
+     */
+    private function promoteNoPriceLine(PriceAskingRequest $request, int $productId, array $r, int $me): void
+    {
+        $companyId = (int) $request->company_id;
+        $unitRow = DB::table('product_units')->where('product_id', $productId)->where('unit_id', (int) $r['unit_id'])->orderByDesc('is_base')->first(['id']);
+        if (!$unitRow) {
+            $unitRow = DB::table('product_units')->where('product_id', $productId)->where('is_base', 1)->first(['id']);
+        }
+        if (!$unitRow) {
+            $code = (string) DB::table('products')->where('id', $productId)->value('code');
+            throw ValidationException::withMessages(['temp_products' => [$code . ': chưa đủ điều kiện duyệt không cần tính giá']]);
+        }
+        $cost = (float) $r['cost'];
+        $sale = (float) $r['sale'];
+        $coef = $cost > 0 ? round($sale / $cost, 2) : 0.0;
+        $prices = [];
+        foreach (ProductPriceListService::TYPE_ORDER as $type) {
+            $prices[] = [
+                'price_type_id' => $type, 'price' => $sale, 'coefficient' => $coef, 'sale_max_percent' => 0, 'expected_prices' => [],
+                'is_manual_price_online' => true, 'is_manual_coefficient_online' => true, 'is_manual_sale_max_percent_online' => true,
+            ];
+        }
+        $writer = app(ProductPriceWriter::class);
+        $note = 'Duyệt không cần tính giá - Yêu cầu hỏi giá ' . $request->code;
+        $writer->apply($productId, (int) $unitRow->id, $companyId, $writer->resolvePrices($prices, $companyId), $cost, $note, $me);
+
+        $moved = app(ProductHistoryService::class)->trackStatus($companyId, [$productId], function () use ($productId, $companyId, $me) {
+            return DB::table('product_company_coefficients')->where('product_id', $productId)->where('company_id', $companyId)
+                ->where('status', ProductCompany::STATUS_TEMP_APPROVED_NO_PRICE)
+                ->update(['status' => ProductCompany::STATUS_TRADING, 'updated_by' => $me, 'updated_at' => now()]);
+        }, null, 'Yêu cầu hỏi giá ' . $request->code . '. Duyệt không cần tính giá');
+        if ($moved) {
+            app(ProductPriceSetWriter::class)->ensureProductSet($productId, $companyId, $me);
+        }
+        $code = (string) DB::table('products')->where('id', $productId)->value('code');
+        $this->log($request->id, null, self::LOG_TEMP_NO_PRICE, $code . ': giá nhập ' . $cost . ', giá bán ' . $sale, $me);
+    }
