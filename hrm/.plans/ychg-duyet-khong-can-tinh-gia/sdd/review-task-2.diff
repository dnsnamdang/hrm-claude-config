+<?php
+
+namespace Modules\MasterData\Services\PriceCalculation;
+
+use Illuminate\Support\Facades\DB;
+use Modules\Assign\Entities\Quotation;
+use Modules\Assign\Services\QuotationService;
+
+/**
+ * YCHG "Duyệt không cần tính giá" — phân loại hàng tạm + resolve giá để ghi (KHÔNG ghi giá, KHÔNG đổi trạng thái).
+ *
+ * TH2 (won_bid): hàng có dòng báo giá của báo giá TRÚNG THẦU → giá nhập/bán từ dòng báo giá × tỷ giá HIỆN TẠI
+ *                (QuotationService::resolveCurrentExchangeRate, không dùng tỷ giá đóng băng trên báo giá).
+ * TH1 (zero):    giá nhập (product_company_units.cost_price) = 0 VÀ giá bán lẻ loại 1 (product_unit_prices) = 0
+ *                TƯỜNG MINH ở ĐVT gốc tại công ty. Thiếu dòng = KHÔNG đủ điều kiện.
+ */
+class TempNoPriceResolver
+{
+    private const RETAIL_PRICE_TYPE_ID = 1;
+
+    /**
+     * @return array|null null = không đủ điều kiện; ['case'=>'won_bid'|'zero','cost'=>float,'sale'=>float,'unit_id'=>int]
+     */
+    public function resolve(int $productId, int $companyId): ?array
+    {
+        $won = $this->resolveWonBid($productId);
+        if ($won !== null) {
+            return $won;
+        }
+        return $this->resolveZero($productId, $companyId);
+    }
+
+    private function resolveWonBid(int $productId): ?array
+    {
+        $row = DB::table('quotation_product_prices as qpp')
+            ->join('quotations as q', 'q.id', '=', 'qpp.quotation_id')
+            ->where('qpp.erp_product_id', $productId)
+            ->where('q.status', Quotation::STATUS_TRUNG_THAU)
+            ->whereNotNull('qpp.estimated_price')
+            ->whereNotNull('qpp.quoted_price')
+            ->orderByDesc('q.id')
+            ->orderByDesc('qpp.id')
+            ->first(['q.id as quotation_id', 'qpp.estimated_price', 'qpp.quoted_price', 'qpp.unit_id']);
+        if (!$row) {
+            return null;
+        }
+        $unitId = (int) $row->unit_id;
+        if ($unitId <= 0) {
+            $base = $this->baseUnit($productId);
+            $unitId = $base ? (int) $base->unit_id : 0;
+        }
+        $quotation = Quotation::find($row->quotation_id);
+        $rate = app(QuotationService::class)->resolveCurrentExchangeRate($quotation);
+
+        return [
+            'case' => 'won_bid',
+            'cost' => (float) $row->estimated_price * $rate,
+            'sale' => (float) $row->quoted_price * $rate,
+            'unit_id' => $unitId,
+        ];
+    }
+
+    private function resolveZero(int $productId, int $companyId): ?array
+    {
+        $base = $this->baseUnit($productId);
+        if (!$base) {
+            return null;
+        }
+        $cost = DB::table('product_company_units')
+            ->where('product_unit_id', $base->id)->where('company_id', $companyId)->value('cost_price');
+        $sale = DB::table('product_unit_prices')
+            ->where('product_unit_id', $base->id)->where('company_id', $companyId)
+            ->where('price_type_id', self::RETAIL_PRICE_TYPE_ID)->value('price');
+        if ($cost === null || $sale === null || (float) $cost != 0.0 || (float) $sale != 0.0) {
+            return null;
+        }
+        return ['case' => 'zero', 'cost' => 0.0, 'sale' => 0.0, 'unit_id' => (int) $base->unit_id];
+    }
+
+    private function baseUnit(int $productId): ?object
+    {
+        return DB::table('product_units')->where('product_id', $productId)->where('is_base', 1)->first(['id', 'unit_id']);
+    }
+}
