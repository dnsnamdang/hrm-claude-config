+<?php
+
+namespace Modules\MasterData\Tests\Feature;
+
+use Illuminate\Foundation\Testing\DatabaseTransactions;
+use Illuminate\Support\Facades\DB;
+use Modules\MasterData\Services\PriceCalculation\TempNoPriceResolver;
+use Tests\TestCase;
+
+/**
+ * YCHG "Duyệt không cần tính giá" — Task 2: TempNoPriceResolver (TH1 giá 0 tường minh / TH2 kế thừa báo giá trúng thầu).
+ */
+class PriceAskingNoPriceApproveTest extends TestCase
+{
+    use DatabaseTransactions;
+
+    private const CO = 1;
+
+    private function mkProduct(): array
+    {
+        $t = 'NP' . substr(uniqid(), -7);
+        $pid = (int) DB::table('products')->insertGetId([
+            'code' => $t, 'name' => "Hàng $t", 'created_at' => now(), 'updated_at' => now(),
+        ]);
+        $unitId = (int) DB::table('units')->insertGetId([
+            'code' => $t . 'U', 'name' => "ĐVT $t", 'created_at' => now(), 'updated_at' => now(),
+        ]);
+        $puId = (int) DB::table('product_units')->insertGetId([
+            'unit_id' => $unitId, 'product_id' => $pid, 'is_base' => 1, 'unit_coefficient' => 1, 'cost_price' => 0,
+            'created_at' => now(), 'updated_at' => now(),
+        ]);
+        return [$pid, $unitId, $puId];
+    }
+
+    private function mkQuote(int $pid, int $status, ?int $currencyId, float $est, float $quo, int $unitId): int
+    {
+        $t = 'Q' . substr(uniqid(), -8) . mt_rand(10, 99);
+        $qid = (int) DB::table('quotations')->insertGetId([
+            'code' => $t, 'customer_id' => 1, 'customer_name' => 'KH', 'status' => $status,
+            'currency_id' => $currencyId, 'created_at' => now(), 'updated_at' => now(),
+        ]);
+        DB::table('quotation_product_prices')->insert([
+            'quotation_id' => $qid, 'erp_product_id' => $pid, 'unit_id' => $unitId,
+            'estimated_price' => $est, 'quoted_price' => $quo, 'created_at' => now(), 'updated_at' => now(),
+        ]);
+        return $qid;
+    }
+
+    private function setPrices(int $puId, int $pid, ?float $cost, ?float $retail): void
+    {
+        if ($cost !== null) {
+            DB::table('product_company_units')->insert([
+                'product_unit_id' => $puId, 'company_id' => self::CO, 'product_id' => $pid, 'cost_price' => $cost,
+                'created_at' => now(), 'updated_at' => now(),
+            ]);
+        }
+        if ($retail !== null) {
+            DB::table('product_unit_prices')->insert([
+                'price_type_id' => 1, 'product_unit_id' => $puId, 'company_id' => self::CO, 'price' => $retail,
+                'coefficient' => 1, 'created_at' => now(), 'updated_at' => now(),
+            ]);
+        }
+    }
+
+    private function resolve(int $pid): ?array
+    {
+        return app(TempNoPriceResolver::class)->resolve($pid, self::CO);
+    }
+
+    public function test_resolve_won_bid_vnd(): void
+    {
+        [$pid, $unitId] = $this->mkProduct();
+        $this->mkQuote($pid, 7, null, 100, 150, $unitId);
+        $this->assertSame(['case' => 'won_bid', 'cost' => 100.0, 'sale' => 150.0, 'unit_id' => $unitId], $this->resolve($pid));
+    }
+
+    public function test_resolve_won_bid_foreign_currency_multiplies_rate(): void
+    {
+        [$pid, $unitId] = $this->mkProduct();
+        $cid = (int) DB::table('currencies')->insertGetId([
+            'code' => 'XX' . mt_rand(100, 999), 'name' => 'Test', 'status' => 1, 'exchange_rate' => 25000,
+            'created_at' => now(), 'updated_at' => now(),
+        ]);
+        $this->mkQuote($pid, 7, $cid, 2, 3, $unitId);
+        $this->assertSame(['case' => 'won_bid', 'cost' => 50000.0, 'sale' => 75000.0, 'unit_id' => $unitId], $this->resolve($pid));
+    }
+
+    public function test_resolve_won_bid_picks_latest_quotation(): void
+    {
+        [$pid, $unitId] = $this->mkProduct();
+        $this->mkQuote($pid, 7, null, 10, 20, $unitId);
+        $this->mkQuote($pid, 7, null, 11, 22, $unitId);
+        $r = $this->resolve($pid);
+        $this->assertSame(11.0, $r['cost']);
+        $this->assertSame(22.0, $r['sale']);
+    }
+
+    public function test_resolve_zero_when_explicit_zero_prices(): void
+    {
+        [$pid, $unitId, $puId] = $this->mkProduct();
+        $this->setPrices($puId, $pid, 0, 0);
+        $this->assertSame(['case' => 'zero', 'cost' => 0.0, 'sale' => 0.0, 'unit_id' => $unitId], $this->resolve($pid));
+    }
+
+    public function test_resolve_null_when_price_missing(): void
+    {
+        [$pid, , $puId] = $this->mkProduct();
+        $this->assertNull($this->resolve($pid));                 // không dòng giá nào
+        $this->setPrices($puId, $pid, 0, null);                   // chỉ có cost=0, thiếu giá bán
+        $this->assertNull($this->resolve($pid));
+    }
+
+    public function test_resolve_null_when_no_won_bid_and_nonzero(): void
+    {
+        [$pid, $unitId, $puId] = $this->mkProduct();
+        $this->mkQuote($pid, 3, null, 100, 150, $unitId);         // chưa trúng thầu
+        $this->setPrices($puId, $pid, 100, 0);                    // cost != 0
+        $this->assertNull($this->resolve($pid));
+    }
+}
